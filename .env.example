# 这份文件是"要哪些键"的说明，不要直接改它来配环境。
# 真正的 .env 用脚本从线上领（权限 600）：
#
#   .venv/bin/python scripts/fetch_projenv.py --token <PROJENV_TOKEN>
#
# 端点：GET https://voice.aibeaver.cn/projenv   ← 与桌面端的 /credential 相互独立
# 本地调试也可以手抄一份成 .env（不要提交）。

# ---- 豆包 TTS（合成语料）----
DOUBAO_APP_ID=
DOUBAO_ACCESS_TOKEN=
DOUBAO_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_URL=https://openspeech.bytedance.com/api/v1/tts

# ---- 腾讯云 ASR（桌面端用；本项目的 /note-log 不依赖它）----
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_ASR_REGION=ap-shanghai
TENCENT_ASR_ENGINE_TYPE=16k_zh

# ---- 阿里云 OSS（种子语料下载 / 合成音频上传）----
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=https://oss-cn-heyuan.aliyuncs.com
OSS_BUCKET=ai-gallery-aibeaver-hy
OSS_PREFIX=classroom/voice-playground
OSS_CDN_BASE=https://cdn.aibeaver.cn/classroom

# ---- 可选：路径覆盖（默认都在项目内，测试时指到临时目录）----
# NOVA_DATA_ROOT=./data
# NOVA_CACHE_ROOT=./.cache
# NOVA_BACKBONE_DIR=./models/backbone/openwakeword
# NOVA_TRAIN_THREADS=2
# NOVA_MAX_RUNNING_TRAININGS=1
